{
	"name": "@sepale/components",
	"version": "0.1.1",
	"description": "Sepale's Svelte components, typed by the family stylesheet you import. Optional class prefix as a Vite plugin.",
	"type": "module",
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"bin": {
		"sepale-types": "./dist/sepale-types.js"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		},
		"./vite": {
			"types": "./dist/vite.d.ts",
			"default": "./dist/vite.js"
		},
		"./prefix": {
			"types": "./dist/prefix.d.ts",
			"default": "./dist/prefix.js"
		}
	},
	"files": [
		"dist",
		"!dist/**/*.test.*"
	],
	"sideEffects": false,
	"peerDependencies": {
		"@sepale/style": "^0.1.1",
		"svelte": "^5.0.0"
	},
	"peerDependenciesMeta": {
		"@sepale/style": {
			"optional": true
		}
	},
	"devDependencies": {
		"@sepale/style": "workspace:^"
	},
	"scripts": {
		"prepublishOnly": "pnpm --dir ../.. run package"
	},
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Tyrenn/sepale.git",
		"directory": "packages/components"
	},
	"bugs": {
		"url": "https://github.com/Tyrenn/sepale/issues"
	},
	"license": "MIT"
}
