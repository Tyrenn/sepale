{
	"name": "@sepale/components",
	"version": "0.0.1",
	"description": "Sepale's Svelte components, with one typed entry point per CSS family.",
	"type": "module",
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		},
		"./*": {
			"types": "./dist/families/*.d.ts",
			"svelte": "./dist/families/*.js"
		}
	},
	"files": [
		"dist",
		"!dist/**/*.test.*"
	],
	"sideEffects": false,
	"peerDependencies": {
		"@sepale/style": "^0.0.1",
		"svelte": "^5.0.0"
	},
	"peerDependenciesMeta": {
		"@sepale/style": {
			"optional": true
		}
	},
	"scripts": {
		"prepublishOnly": "pnpm --dir ../.. run package"
	},
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Tyrenn/sepale.git",
		"directory": "packages/components"
	},
	"bugs": {
		"url": "https://github.com/Tyrenn/sepale/issues"
	},
	"license": "MIT"
}
