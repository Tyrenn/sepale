{
	"name": "@sepale/style",
	"version": "0.1.1",
	"description": "Sepale's opinionated CSS families and their themes, as plain compiled stylesheets. No dependency, no build step.",
	"type": "module",
	"exports": {
		"./*.css": {
			"types": "./dist/*.css.d.ts",
			"default": "./dist/*.css"
		}
	},
	"files": [
		"dist"
	],
	"sideEffects": [
		"**/*.css"
	],
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Tyrenn/sepale.git",
		"directory": "packages/style"
	},
	"bugs": {
		"url": "https://github.com/Tyrenn/sepale/issues"
	},
	"license": "MIT"
}
